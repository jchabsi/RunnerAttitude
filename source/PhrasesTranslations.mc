    hidden static const PHRASES_FRE as Lang.Array = [
        "Merci d'utiliser le cadran Runner Attitude. Allez courir !",
        "Courir, c'est trouver sa paix interieure, comme dans une vie bien vecue.",
        "Cours pour ajouter de la vie a tes journees.",
        "Choisis la course comme therapie.",
        "N'attends rien de ta course, et tu recevras plus que tu ne l'imagines.",
        "Ce qui compte, c'est d'etre coureur, pas ta vitesse ni la distance parcourue.",
        "Gagner ne veut pas toujours dire finir premier; cela veut dire donner le meilleur de soi.",
        "Tu dois faire ce que tu crois impossible.",
        "Si cela ne te met pas au defi, cela ne te changera pas.",
        "L'homme qui deplace une montagne commence par de petites pierres.",
