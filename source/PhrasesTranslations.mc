    static function getPhraseList(language as Lang.Number) as Lang.Array? {
        switch (language) {
            case English: return PHRASES_ENG;
            case Spanish: return PHRASES_SPA;
            case Italian: return PHRASES_ITA;
            case French: return PHRASES_FRE;
            case Portuguese: return PHRASES_POR;
        }
        return null;
    }

    static function getFixedList(language as Lang.Number) as Lang.Array? {
        switch (language) {
            case English: return FIXED_ENG;
            case Spanish: return FIXED_SPA;
            case Italian: return FIXED_ITA;
            case French: return FIXED_FRE;
            case Portuguese: return FIXED_POR;
        }
        return null;
    }

    static function getInsertText(language as Lang.Number) as Lang.String? {
        switch (language) {
            case English: return INSERT_ENG;
            case Spanish: return INSERT_SPA;
            case Italian: return INSERT_ITA;
            case French: return INSERT_FRE;
            case Portuguese: return INSERT_POR;
        }
        return null;
    }
}
